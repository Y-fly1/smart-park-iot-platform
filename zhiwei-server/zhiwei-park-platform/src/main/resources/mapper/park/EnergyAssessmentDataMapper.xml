<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhiwei.park.mapper.EnergyAssessmentDataMapper">
    
    <resultMap type="EnergyAssessmentData" id="EnergyAssessmentDataResult">
        <result property="id"    column="id"    />
        <result property="basicInfo"    column="basic_info"    />
        <result property="energyAssessment"    column="energy_assessment"    />
        <result property="dailyLivingActivities"    column="electricity"    />
        <result property="mentalState"    column="water"    />
        <result property="perceptionCommunication"    column="gas"    />
        <result property="socialParticipation"    column="hvac"    />
        <result property="assessmentDetails"    column="assessment_details"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectEnergyAssessmentDataVo">
        select id, basic_info, energy_assessment, electricity, water, gas, hvac, assessment_details, create_time, update_time, create_by, update_by, remark from energy_assessment_data
    </sql>

    <select id="selectEnergyAssessmentDataList" parameterType="EnergyAssessmentData" resultMap="EnergyAssessmentDataResult">
        <include refid="selectEnergyAssessmentDataVo"/>
        <where>  
            <if test="basicInfo != null  and basicInfo != ''"> and basic_info = #{basicInfo}</if>
            <if test="energyAssessment != null  and energyAssessment != ''"> and energy_assessment = #{energyAssessment}</if>
            <if test="dailyLivingActivities != null  and dailyLivingActivities != ''"> and electricity = #{dailyLivingActivities}</if>
            <if test="mentalState != null  and mentalState != ''"> and water = #{mentalState}</if>
            <if test="perceptionCommunication != null  and perceptionCommunication != ''"> and gas = #{perceptionCommunication}</if>
            <if test="socialParticipation != null  and socialParticipation != ''"> and hvac = #{socialParticipation}</if>
            <if test="assessmentDetails != null  and assessmentDetails != ''"> and assessment_details = #{assessmentDetails}</if>
        </where>
    </select>
    
    <select id="selectEnergyAssessmentDataById" parameterType="Long" resultMap="EnergyAssessmentDataResult">
        <include refid="selectEnergyAssessmentDataVo"/>
        where id = #{id}
    </select>

    <insert id="insertEnergyAssessmentData" parameterType="EnergyAssessmentData">
        insert into energy_assessment_data
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="basicInfo != null">basic_info,</if>
            <if test="energyAssessment != null">energy_assessment,</if>
            <if test="dailyLivingActivities != null">electricity,</if>
            <if test="mentalState != null">water,</if>
            <if test="perceptionCommunication != null">gas,</if>
            <if test="socialParticipation != null">hvac,</if>
            <if test="assessmentDetails != null">assessment_details,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="basicInfo != null">#{basicInfo},</if>
            <if test="energyAssessment != null">#{energyAssessment},</if>
            <if test="dailyLivingActivities != null">#{dailyLivingActivities},</if>
            <if test="mentalState != null">#{mentalState},</if>
            <if test="perceptionCommunication != null">#{perceptionCommunication},</if>
            <if test="socialParticipation != null">#{socialParticipation},</if>
            <if test="assessmentDetails != null">#{assessmentDetails},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateEnergyAssessmentData" parameterType="EnergyAssessmentData">
        update energy_assessment_data
        <trim prefix="SET" suffixOverrides=",">
            <if test="basicInfo != null">basic_info = #{basicInfo},</if>
            <if test="energyAssessment != null">energy_assessment = #{energyAssessment},</if>
            <if test="dailyLivingActivities != null">electricity = #{dailyLivingActivities},</if>
            <if test="mentalState != null">water = #{mentalState},</if>
            <if test="perceptionCommunication != null">gas = #{perceptionCommunication},</if>
            <if test="socialParticipation != null">hvac = #{socialParticipation},</if>
            <if test="assessmentDetails != null">assessment_details = #{assessmentDetails},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteEnergyAssessmentDataById" parameterType="Long">
        delete from energy_assessment_data where id = #{id}
    </delete>

    <delete id="deleteEnergyAssessmentDataByIds" parameterType="String">
        delete from energy_assessment_data where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>