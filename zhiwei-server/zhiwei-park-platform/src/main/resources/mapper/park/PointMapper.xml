<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhiwei.park.mapper.PointMapper">
    
    <resultMap type="Point" id="PointResult">
        <result property="id"    column="id"    />
        <result property="pointCode"    column="point_code"    />
        <result property="pointStatus"    column="point_status"    />
        <result property="sort"    column="sort"    />
        <result property="roomId"    column="room_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectPointVo">
        select id, point_code, point_status, sort, room_id, create_time, update_time, create_by, update_by, remark from point
    </sql>

    <select id="selectPointList" parameterType="Point" resultMap="PointResult">
        <include refid="selectPointVo"/>
        <where>  
            <if test="pointCode != null  and pointCode != ''"> and point_code = #{pointCode}</if>
            <if test="pointStatus != null "> and point_status = #{pointStatus}</if>
            <if test="sort != null "> and sort = #{sort}</if>
            <if test="roomId != null "> and room_id = #{roomId}</if>
        </where>
    </select>
    
    <select id="selectPointById" parameterType="Long" resultMap="PointResult">
        <include refid="selectPointVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertPoint" parameterType="Point" useGeneratedKeys="true" keyProperty="id">
        insert into point
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="pointCode != null">point_code,</if>
            <if test="pointStatus != null">point_status,</if>
            <if test="sort != null">sort,</if>
            <if test="roomId != null">room_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="pointCode != null">#{pointCode},</if>
            <if test="pointStatus != null">#{pointStatus},</if>
            <if test="sort != null">#{sort},</if>
            <if test="roomId != null">#{roomId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updatePoint" parameterType="Point">
        update point
        <trim prefix="SET" suffixOverrides=",">
            <if test="pointCode != null">point_code = #{pointCode},</if>
            <if test="pointStatus != null">point_status = #{pointStatus},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="roomId != null">room_id = #{roomId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePointById" parameterType="Long">
        delete from point where id = #{id}
    </delete>

    <delete id="deletePointByIds" parameterType="String">
        delete from point where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>