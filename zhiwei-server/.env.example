# ============================================================
# 智维云 - 后端环境变量示例
# 用法：复制为 .env（已在 .gitignore 中忽略）后填入自己的值
# 说明：所有变量在 application-*.yml 中均有本地默认值，
#      不配置也能启动；只有需要对接真实云服务时才必须填写。
# ============================================================

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zhiwei
DB_USERNAME=root
DB_PASSWORD=

# ---------- Redis（业务缓存 / 会话） ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 向量库（知识库 RAG 检索，需 Redis Stack 或独立 Redis Stack 实例） ----------
VECTOR_REDIS_HOST=localhost
VECTOR_REDIS_PORT=6379
VECTOR_REDIS_INDEX=spring-ai-index
# 首次启动自动创建向量索引；生产环境建议由运维预建后设为 false
VECTOR_REDIS_INIT_SCHEMA=true

# ---------- 大模型（阿里云百炼 DashScope，OpenAI 兼容接口） ----------
BAI_LIAN_API_KEY=
BAI_LIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
BAI_LIAN_CHAT_MODEL=qwen-plus
BAI_LIAN_EMBEDDING_MODEL=text-embedding-v4

# ---------- Dify 智能体（能效咨询对话，SSE 流式） ----------
DIFY_BASE_URL=http://localhost/v1
DIFY_API_KEY=

# ---------- 微信小程序（联系人端登录、手机号获取） ----------
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=

# ---------- 阿里云 OSS（体检报告、知识库 PDF 存储） ----------
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=

# ---------- 华为云 IoTDA（设备接入，未配置时自动跳过设备数据订阅） ----------
HUAWEI_IOT_AK=
HUAWEI_IOT_SK=
HUAWEI_IOT_REGION=cn-north-4
HUAWEI_IOT_ENDPOINT=
HUAWEI_IOT_PROJECT_ID=
HUAWEI_IOT_AMQP_HOST=
HUAWEI_IOT_AMQP_ACCESS_KEY=
HUAWEI_IOT_AMQP_ACCESS_CODE=
HUAWEI_IOT_AMQP_QUEUE=DefaultQueue

# ---------- 安全 ----------
# JWT 签名密钥，生产环境务必替换为随机长字符串
TOKEN_SECRET=please-change-this-to-a-random-secret
