    <sql id="selectSettleInConfigVo">
        select id, settle_in_id, service_level_id, service_level_name, fee_start_date, fee_end_date, deposit, service_fee, site_fee, insurance_payment, government_subsidy, other_fees, sort_order, create_time, update_time, create_by, update_by, remark from settle_in_config
    </sql>

    <select id="selectSettleInConfigList" parameterType="SettleInConfig" resultMap="SettleInConfigResult">
        <include refid="selectSettleInConfigVo"/>
        <where>  
            <if test="settleInId != null "> and settle_in_id = #{settleInId}</if>
            <if test="serviceLevelId != null "> and service_level_id = #{serviceLevelId}</if>
            <if test="serviceLevelName != null  and serviceLevelName != ''"> and service_level_name like concat('%', #{serviceLevelName}, '%')</if>
            <if test="feeStartDate != null "> and fee_start_date = #{feeStartDate}</if>
            <if test="feeEndDate != null "> and fee_end_date = #{feeEndDate}</if>
            <if test="deposit != null "> and deposit = #{deposit}</if>
            <if test="serviceFee != null "> and service_fee = #{serviceFee}</if>
            <if test="siteFee != null "> and site_fee = #{siteFee}</if>
            <if test="insurancePayment != null "> and insurance_payment = #{insurancePayment}</if>
            <if test="governmentSubsidy != null "> and government_subsidy = #{governmentSubsidy}</if>
            <if test="otherFees != null "> and other_fees = #{otherFees}</if>
            <if test="sortOrder != null "> and sort_order = #{sortOrder}</if>
        </where>
    </select>
    
    <select id="selectSettleInConfigById" parameterType="Long" resultMap="SettleInConfigResult">
        <include refid="selectSettleInConfigVo"/>
        where id = #{id}
