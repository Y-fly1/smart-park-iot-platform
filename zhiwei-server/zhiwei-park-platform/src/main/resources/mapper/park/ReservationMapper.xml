<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhiwei.park.mapper.ReservationMapper">

    <resultMap type="Reservation" id="ReservationResult">
        <result property="id"       column="id"       />
        <result property="name"     column="name"     />
        <result property="mobile"   column="mobile"   />
        <result property="time"     column="time"     />
        <result property="visitor"  column="visitor"  />
        <result property="type"     column="type"     />
        <result property="status"   column="status"   />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark"   column="remark"   />
    </resultMap>

    <sql id="selectReservationVo">
        select id, name, mobile, time, visitor, type, status,
               create_by, create_time, update_by, update_time, remark
        from reservation
    </sql>

    <select id="selectReservationList" parameterType="Reservation" resultMap="ReservationResult">
        <include refid="selectReservationVo"/>
        <where>
            <if test="createBy != null and createBy != ''"> and create_by = #{createBy}</if>
            <if test="status != null"> and status = #{status}</if>
        </where>
        order by time desc, id desc
    </select>

    <select id="selectTimeUsedCount" resultType="com.zhiwei.park.domain.vo.ReservationTimeCountVo">
        select time, count(*) as count
        from reservation
        where date(time) = #{date}
          and status in (0, 1)
        group by time
        order by time
    </select>
</mapper>
