<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhiwei.park.mapper.InspectionItemMapper">
    
    <resultMap type="InspectionItem" id="InspectionItemResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="orderNo"    column="order_no"    />
        <result property="unit"    column="unit"    />
        <result property="price"    column="price"    />
        <result property="image"    column="image"    />
        <result property="inspectionRequirement"    column="inspection_requirement"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectInspectionItemVo">
        select id, name, order_no, unit, price, image, inspection_requirement, status, create_by, update_by, remark, create_time, update_time from inspection_item
    </sql>

    <select id="selectInspectionItemList" parameterType="InspectionItem" resultMap="InspectionItemResult">
        <include refid="selectInspectionItemVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectInspectionItemById" parameterType="Long" resultMap="InspectionItemResult">
        <include refid="selectInspectionItemVo"/>
        where id = #{id}
    </select>

    <insert id="insertInspectionItem" parameterType="InspectionItem" useGeneratedKeys="true" keyProperty="id">
        insert into inspection_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="orderNo != null">order_no,</if>
            <if test="unit != null">unit,</if>
            <if test="price != null">price,</if>
            <if test="image != null">image,</if>
            <if test="inspectionRequirement != null">inspection_requirement,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="remark != null">remark,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="orderNo != null">#{orderNo},</if>
            <if test="unit != null">#{unit},</if>
            <if test="price != null">#{price},</if>
            <if test="image != null">#{image},</if>
            <if test="inspectionRequirement != null">#{inspectionRequirement},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateInspectionItem" parameterType="InspectionItem">
        update inspection_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="price != null">price = #{price},</if>
            <if test="image != null">image = #{image},</if>
            <if test="inspectionRequirement != null">inspection_requirement = #{inspectionRequirement},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteInspectionItemById" parameterType="Long">
        delete from inspection_item where id = #{id}
    </delete>

    <delete id="deleteInspectionItemByIds" parameterType="String">
        delete from inspection_item where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>