<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhiwei.park.mapper.EnergyAssessmentMapper">
    
    <resultMap type="EnergyAssessment" id="EnergyAssessmentResult">
        <result property="id"    column="id"    />
        <result property="tenantName"    column="tenant_name"    />
        <result property="creditCode"    column="credit_code"    />
        <result property="tenantId"    column="tenant_id"    />
        <result property="coreSuggestion"    column="core_suggestion"    />
        <result property="settleInStatus"    column="settle_in_status"    />
        <result property="evaluationProgress"    column="evaluation_progress"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectEnergyAssessmentVo">
        select id, tenant_name, credit_code, tenant_id, core_suggestion, settle_in_status, evaluation_progress, create_time, update_time, create_by, update_by, remark from energy_assessment
    </sql>

    <select id="selectEnergyAssessmentList" parameterType="EnergyAssessment" resultMap="EnergyAssessmentResult">
        <include refid="selectEnergyAssessmentVo"/>
        <where>  
            <if test="tenantName != null  and tenantName != ''"> and tenant_name like concat('%', #{tenantName}, '%')</if>
            <if test="creditCode != null  and creditCode != ''"> and credit_code = #{creditCode}</if>
            <if test="tenantId != null "> and tenant_id = #{tenantId}</if>
            <if test="coreSuggestion != null "> and core_suggestion = #{coreSuggestion}</if>
            <if test="settleInStatus != null "> and settle_in_status = #{settleInStatus}</if>
            <if test="evaluationProgress != null "> and evaluation_progress = #{evaluationProgress}</if>
        </where>
    </select>
    
    <select id="selectEnergyAssessmentById" parameterType="Long" resultMap="EnergyAssessmentResult">
        <include refid="selectEnergyAssessmentVo"/>
        where id = #{id}
    </select>

    <insert id="insertEnergyAssessment" parameterType="EnergyAssessment" useGeneratedKeys="true" keyProperty="id">
        insert into energy_assessment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="tenantName != null and tenantName != ''">tenant_name,</if>
            <if test="creditCode != null and creditCode != ''">credit_code,</if>
            <if test="tenantId != null">tenant_id,</if>
            <if test="coreSuggestion != null">core_suggestion,</if>
            <if test="settleInStatus != null">settle_in_status,</if>
            <if test="evaluationProgress != null">evaluation_progress,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="tenantName != null and tenantName != ''">#{tenantName},</if>
            <if test="creditCode != null and creditCode != ''">#{creditCode},</if>
            <if test="tenantId != null">#{tenantId},</if>
            <if test="coreSuggestion != null">#{coreSuggestion},</if>
            <if test="settleInStatus != null">#{settleInStatus},</if>
            <if test="evaluationProgress != null">#{evaluationProgress},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateEnergyAssessment" parameterType="EnergyAssessment">
        update energy_assessment
        <trim prefix="SET" suffixOverrides=",">
            <if test="tenantName != null and tenantName != ''">tenant_name = #{tenantName},</if>
            <if test="creditCode != null and creditCode != ''">credit_code = #{creditCode},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
            <if test="coreSuggestion != null">core_suggestion = #{coreSuggestion},</if>
            <if test="settleInStatus != null">settle_in_status = #{settleInStatus},</if>
            <if test="evaluationProgress != null">evaluation_progress = #{evaluationProgress},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteEnergyAssessmentById" parameterType="Long">
        delete from energy_assessment where id = #{id}
    </delete>

    <delete id="deleteEnergyAssessmentByIds" parameterType="String">
        delete from energy_assessment where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>